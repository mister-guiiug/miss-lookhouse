{
  "app": "miss-lookhouse",
  "entries": [
    {
      "name": "SUPABASE_ACCESS_TOKEN",
      "store": "secrets",
      "phase": "server",
      "required": "optional",
      "purpose": "Secret serveur / migrations (SUPABASE_ACCESS_TOKEN)"
    },
    {
      "name": "SUPABASE_DB_PASSWORD",
      "store": "secrets",
      "phase": "server",
      "required": "optional",
      "purpose": "Secret serveur / migrations (SUPABASE_DB_PASSWORD)"
    },
    {
      "name": "SUPABASE_PROJECT_ID",
      "store": "secrets",
      "phase": "server",
      "required": "optional",
      "purpose": "Secret serveur / migrations (SUPABASE_PROJECT_ID)"
    },
    {
      "name": "VITE_BACKEND",
      "store": "committed",
      "phase": "build",
      "required": "optional",
      "purpose": "Choix de backend (local / supabase / …)"
    },
    {
      "name": "VITE_GEOCODER_URL",
      "store": "committed",
      "phase": "build",
      "required": "optional",
      "purpose": "Service de géocodage"
    },
    {
      "name": "VITE_POSTHOG_KEY",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "Clé projet PostHog (nuage EU)",
      "fallback": "absent : pas de mesure ni bandeau",
      "provider": "posthog"
    },
    {
      "name": "VITE_SENTRY_DSN",
      "store": "vars",
      "phase": "build",
      "required": "optional",
      "purpose": "DSN Sentry",
      "fallback": "absent : no-op",
      "provider": "sentry"
    },
    {
      "name": "VITE_SUPABASE_ANON_KEY",
      "store": "committed",
      "phase": "build",
      "required": "optional",
      "purpose": "Clé anon publique (RLS)",
      "provider": "supabase"
    },
    {
      "name": "VITE_SUPABASE_URL",
      "store": "committed",
      "phase": "build",
      "required": "optional",
      "purpose": "URL du projet Supabase",
      "provider": "supabase"
    },
    {
      "name": "VITE_VAPID_PUBLIC_KEY",
      "store": "committed",
      "phase": "build",
      "required": "optional",
      "purpose": "Clé publique VAPID (Web Push)",
      "provider": "web-push"
    }
  ]
}
