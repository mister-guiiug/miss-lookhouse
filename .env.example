# Engendré par `pwa-env sync` depuis config/env.manifest.json.
# App : miss-lookhouse
# Ne pas éditer à la main : modifier le manifeste, puis relancer sync --write.

# Choix de backend (local / supabase / …)
VITE_BACKEND=

# Service de géocodage
VITE_GEOCODER_URL=

# Clé projet PostHog (nuage EU)
# Repli : absent : pas de mesure ni bandeau
VITE_POSTHOG_KEY=

# DSN Sentry
# Repli : absent : no-op
VITE_SENTRY_DSN=

# Clé anon publique (RLS)
VITE_SUPABASE_ANON_KEY=

# URL du projet Supabase
VITE_SUPABASE_URL=

# Clé publique VAPID (Web Push)
VITE_VAPID_PUBLIC_KEY=
